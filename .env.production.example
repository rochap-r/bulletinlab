# Copier vers .env.production puis renseigner.
#   cp .env.production.example .env.production
# Générer APP_KEY : php artisan key:generate --show
#
# Premier lancement :
#   docker compose --env-file .env.production build
#   docker compose --env-file .env.production --profile maintenance run --rm migrate
#   docker compose --env-file .env.production up -d

# Docker Compose
COMPOSE_PROJECT_NAME=topscolaire
IMAGE_TAG=local

APP_NAME=BulletinLab
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL publique de préproduction (TLS géré par Nginx sur l'hôte)
APP_URL=https://dev.topscolaire.com
CORS_ALLOWED_ORIGINS=https://dev.topscolaire.com
BUSINESS_TIMEZONE=Africa/Lubumbashi
APP_LOCALE=fr

# Logs en sortie standard (docker logs)
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

BCRYPT_ROUNDS=12

# Comptes initiaux créés ou synchronisés par les seeders.
# Choisir trois mots de passe distincts d'au moins 12 caractères.
# Conserver les guillemets, notamment si la valeur contient # ou des espaces.
PLATFORM_ADMIN_PASSWORD=""
DEMO_ADMIN_PASSWORD=""
DEMO_TEACHER_PASSWORD=""

# PostgreSQL 18 (service "db" du compose)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bulletinlab
DB_USERNAME=bulletinlab
DB_PASSWORD=

# Redis (service "redis" du compose) : cache, sessions et queue
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=
# Laravel ne fait confiance qu'au proxy HTTP immédiat transmis par FastCGI.
# L'accès direct aux ports Docker doit rester limité à localhost.
TRUSTED_PROXIES=REMOTE_ADDR

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Interpolation docker-compose.yml (pas Laravel)
# Ports publiés sur localhost uniquement (proxy TLS externe / tunnel SSH)
FRONTEND_HTTP_PORT=8080
API_HTTP_PORT=8081

# Adminer (console PG, démarrée avec : docker compose --env-file .env.production --profile tools up -d adminer)
# Bindé sur 127.0.0.1 : utilisez un tunnel SSH (ssh -L 8082:127.0.0.1:8082) si le serveur est distant.
ADMINER_HTTP_PORT=8082
# URL de base API vue par le navigateur :
#   /api/v1                  → same-origin via le proxy nginx du frontend
#   https://api.exemple.cd/v1 → appel direct (nécessite CORS_ALLOWED_ORIGINS)
VITE_API_BASE_URL=/api/v1
