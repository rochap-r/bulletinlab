# Stack Docker production — TopScolaire
# Copier ce fichier vers .env.production sur le serveur de production
# (chemin attendu par deploy/production-deploy.sh : /opt/topscolaire/.env.production)
# et adapter les valeurs sensibles.

COMPOSE_PROJECT_NAME=topscolaire
IMAGE_TAG=latest

APP_NAME=TopScolaire
APP_ENV=production
APP_KEY=base64:GENEREZ_UNE_CLE_APP_KEY_32_OCTETS_BASE64
APP_DEBUG=false
APP_URL=https://topscolaire.com

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=topscolaire
DB_USERNAME=topscolaire
DB_PASSWORD=MOT_DE_PASSE_DB_PRODUCTION

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

FRONTEND_HTTP_PORT=8080
API_HTTP_PORT=8081
ADMINER_HTTP_PORT=8082

VITE_API_BASE_URL=/api/v1
