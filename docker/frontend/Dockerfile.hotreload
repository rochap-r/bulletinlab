# syntax=docker/dockerfile:1

# Image Vite dev server pour le hot reload en développement.
# Le code source est monté en volume au runtime ; node_modules est préservé
# par un volume anonyme pour éviter les node_modules de l'hôte (Windows).
FROM node:22-alpine

WORKDIR /app

# Dépendances installées au build (binaire Linux, compatible Alpine)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Variable par défaut (surchargée par docker-compose si besoin)
ENV VITE_API_PROXY_TARGET=http://api-nginx:80

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

EXPOSE 5173
